+String Navigator::vendor() const {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+
+  if (command_line->HasSwitch(switches::kFingerprintVendor)) {
+    std::string custom_vendor = command_line->GetSwitchValueASCII(switches::kFingerprintVendor);
+    return String(custom_vendor);
+  }
+
+  // Preserve original behavior based on platform
+  return String();
+}
